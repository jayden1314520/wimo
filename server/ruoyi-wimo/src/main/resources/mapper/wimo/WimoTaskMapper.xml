<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.wimo.mapper.WimoTaskMapper">

    <resultMap type="com.ruoyi.wimo.domain.WimoTask" id="WimoTaskResult">
        <id     property="taskId"        column="task_id"       />
        <result property="userId"        column="user_id"       />
        <result property="taskType"      column="task_type"     />
        <result property="productName"   column="product_name"  />
        <result property="sellingPoints" column="selling_points"/>
        <result property="ratio"         column="ratio"         />
        <result property="platform"      column="platform"      />
        <result property="region"        column="region"        />
        <result property="lang"          column="lang"          />
        <result property="resolution"    column="resolution"    />
        <result property="quality"       column="quality"       />
        <result property="model"         column="model"         />
        <result property="resultMode"    column="result_mode"   />
        <result property="images"        column="images"        />
        <result property="status"        column="status"        />
        <result property="progress"      column="progress"      />
        <result property="results"       column="results"       />
        <result property="extra"         column="extra"         />
        <result property="errorMsg"      column="error_msg"     />
        <result property="createTime"    column="create_time"   />
        <result property="updateTime"    column="update_time"   />
    </resultMap>

    <sql id="selectTaskVo">
        select task_id, user_id, task_type, product_name, selling_points, ratio, platform, region, lang,
               resolution, quality, model, result_mode, images, status, progress, results, extra,
               error_msg, create_time, update_time
        from wimo_task
    </sql>

    <insert id="insertTask" parameterType="com.ruoyi.wimo.domain.WimoTask" useGeneratedKeys="true" keyProperty="taskId">
        insert into wimo_task (
            user_id, task_type, product_name, selling_points, ratio, platform, region, lang,
            resolution, quality, model, result_mode, images, status, progress,
            extra, error_msg, create_time, update_time
        ) values (
            #{userId}, #{taskType}, #{productName}, #{sellingPoints}, #{ratio}, #{platform}, #{region}, #{lang},
            #{resolution}, #{quality}, #{model}, #{resultMode}, #{images}, #{status}, #{progress},
            #{extra}, #{errorMsg}, #{createTime}, #{updateTime}
        )
    </insert>

    <update id="updateTask" parameterType="com.ruoyi.wimo.domain.WimoTask">
        update wimo_task
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="progress != null">progress = #{progress},</if>
            <if test="results != null">results = #{results},</if>
            <if test="errorMsg != null">error_msg = #{errorMsg},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where task_id = #{taskId}
    </update>

    <select id="selectTaskById" parameterType="java.lang.Long" resultMap="WimoTaskResult">
        <include refid="selectTaskVo"/>
        where task_id = #{taskId}
    </select>

    <select id="selectTaskList" parameterType="com.ruoyi.wimo.domain.WimoTask" resultMap="WimoTaskResult">
        <include refid="selectTaskVo"/>
        <where>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="productName != null and productName != ''">and product_name like concat('%', #{productName}, '%')</if>
            <if test="platform != null and platform != ''">and platform = #{platform}</if>
            <if test="userId != null">and user_id = #{userId}</if>
        </where>
        order by task_id desc
    </select>

    <delete id="deleteTaskByIds" parameterType="java.lang.Long">
        delete from wimo_task where task_id in
        <foreach collection="array" item="taskId" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>

</mapper>
